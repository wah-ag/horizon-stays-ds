{
  "border-radius-none": {
    "$type": "dimension",
    "$value": {
      "value": 0,
      "unit": "px"
    },
    "$description": "0px · 0× the 4px grid\nSquare. Data tables, full-bleed media, and anything that meets a container edge."
  },
  "border-radius-xs": {
    "$type": "dimension",
    "$value": {
      "value": 4,
      "unit": "px"
    },
    "$description": "4px · 1× the 4px grid\nSmall controls — checkboxes, tags, inline code, tooltips."
  },
  "border-radius-sm": {
    "$type": "dimension",
    "$value": {
      "value": 8,
      "unit": "px"
    },
    "$description": "8px · 2× the 4px grid\nThe default. Buttons, inputs, chips, small cards."
  },
  "border-radius-md": {
    "$type": "dimension",
    "$value": {
      "value": 12,
      "unit": "px"
    },
    "$description": "12px · 3× the 4px grid\nCards, panels, dropdown menus."
  },
  "border-radius-lg": {
    "$type": "dimension",
    "$value": {
      "value": 16,
      "unit": "px"
    },
    "$description": "16px · 4× the 4px grid\nLarge surfaces — modals, sheets, feature cards."
  },
  "border-radius-xl": {
    "$type": "dimension",
    "$value": {
      "value": 24,
      "unit": "px"
    },
    "$description": "24px · 6× the 4px grid\nThe largest true radius. Hero cards, bottom sheets, marketing containers."
  },
  "border-radius-pill": {
    "$type": "dimension",
    "$value": {
      "value": 1000,
      "unit": "px"
    },
    "$description": "1000px · sentinel for fully rounded\nFully rounded. Pills, tag chips, avatars, circular icon buttons. Any value above half the shorter side gives the same result — 1000 is a sentinel, not a measurement."
  },
  "border-width-none": {
    "$type": "dimension",
    "$value": {
      "value": 0,
      "unit": "px"
    },
    "$description": "0px\nNo border. Use to remove an inherited border explicitly, rather than setting its colour to transparent."
  },
  "border-width-xs": {
    "$type": "dimension",
    "$value": {
      "value": 0.5,
      "unit": "px"
    },
    "$description": "0.5px · sub-pixel hairline\nHairline. Dividers and table rules on high-DPI screens, where 1px reads too heavy."
  },
  "border-width-sm": {
    "$type": "dimension",
    "$value": {
      "value": 1,
      "unit": "px"
    },
    "$description": "1px\nThe default. Input borders, card outlines, dividers."
  },
  "border-width-md": {
    "$type": "dimension",
    "$value": {
      "value": 2,
      "unit": "px"
    },
    "$description": "2px\nEmphasis. Focus rings, selected states, active tabs."
  },
